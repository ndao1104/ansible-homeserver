https://{{ tailscale_hostname }} {
    tls /certs/{{ tailscale_hostname }}.crt /certs/{{ tailscale_hostname }}.key

    # handle /grafana/* {
    #     reverse_proxy grafana:3000
    # } 

    redir /vaultwarden /vaultwarden/ 308

    handle /vaultwarden/* {
        reverse_proxy vaultwarden:80
    }

    redir /paperless /paperless/ 308

    handle_path /paperless/* {
        reverse_proxy paperless-webserver:8000
    }

    handle_path /beszel/* {
        request_body {
            max_size 10MB
        }
        reverse_proxy beszel:8090 {
            transport http {
                read_timeout 360s
            }
        }
    }
 
    redir /nextcloud /nextcloud/ 308

    handle_path /nextcloud/* {
        reverse_proxy nextcloud:80
    }

    redir /kuma /kuma/ 308

    handle /kuma/* {
        reverse_proxy uptime-kuma:3001
    }
}