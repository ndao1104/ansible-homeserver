# --- Secrets & credentials (PLAINTEXT ONLY) ---
# NOTE: encrypted files created with `ansible-vault` ARE safe to commit.
# Only plaintext secrets and the vault password file are ignored here.
*.key
*.pem
*.p12
*.pfx
*.crt
secrets.yml
vault_pass.txt
.vault_pass
.vault-pass
*_vault.yml
**/vault/**
host_vars/*.yml
inventory.ini

# --- Ansible-specific sensitive/generated files ---
*.retry
.ansible/
ansible.cfg.local
ansible.cfg
homeservers.yml

# --- Inventory overrides that might contain real IPs/hostnames ---
inventory.local.ini
hosts.local

# --- Runtime data accidentally copied in ---
*data/
*-data/
*.sqlite3
*.db
.env
.env.*

# --- OS/editor clutter ---
.DS_Store
Thumbs.db
*.swp
.vscode/